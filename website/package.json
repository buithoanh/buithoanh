{
  "name": "vc-mobile-care-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build && node scripts/sau-build.mjs",
    "start": "node --env-file-if-exists=.env .next/standalone/server.js",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "nap-du-lieu": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/nap-du-lieu.ts",
    "kiem-tra": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/kiem-tra-bai.ts",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "typecheck": "tsc --noEmit",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "cross-env": "7.0.3",
    "graphql": "16.11.0",
    "gray-matter": "4.0.3",
    "next": "16.3.5",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "typescript": "5.7.3"
  }
}
