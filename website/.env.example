# Sao chép thành .env rồi điền. KHÔNG commit file .env, không bao giờ commit khoá thật.
DATABASE_URL=postgres://vc:vc@localhost:5432/thotoi
# Chuỗi ngẫu nhiên dài, tạo bằng: openssl rand -hex 32
PAYLOAD_SECRET=
# Địa chỉ web, không có dấu / ở cuối (dùng trong link riêng gửi khách)
SITE_URL=http://localhost:3000
# Chỉ đặt =1 khi đã gắn tên miền thật
ALLOW_INDEX=
# Khoá Claude API cho nút "AI viết bản nháp"
ANTHROPIC_API_KEY=
# Mật khẩu database khi chạy bằng docker compose
POSTGRES_PASSWORD=
# Thư mục tư liệu transcript (mặc định ../tu-lieu/transcript)
TU_LIEU_DIR=

# ---------------- Tích hợp bên ngoài (lib/tich-hop/) ----------------
# Thiếu biến: khi chạy thử dùng bản giả lập; khi chạy thật (NODE_ENV=production) gọi tới sẽ báo lỗi rõ ràng.
# Máy staging/CI chạy NODE_ENV=production muốn giả lập thì ghi rõ tên: ban-do,dieu-phoi,zalo-zns,sms,vcparts,ngan-hang,hoa-don (hoặc tat-ca).
# Production thật: để trống.
TICH_HOP_GIA_LAP=

# Bản đồ, geocoding (Google Maps Geocoding API)
GOOGLE_MAPS_API_KEY=

# Phần mềm điều phối VCsoft: web gửi đơn mới sang đây (xem docs/api.md, mục Điều phối)
DIEU_PHOI_URL=
DIEU_PHOI_KEY=
# Số điện thoại trực điều phối, nhận SMS khi có đơn khẩn cấp (không bắt buộc)
SDT_TRUC_DIEU_PHOI=

# Zalo ZNS: access token của Zalo OA và mã mẫu tin cho từng bước (đăng ký mẫu với Zalo; thiếu mẫu nào thì bước đó gửi SMS)
ZALO_ZNS_ACCESS_TOKEN=
ZALO_ZNS_MAU_XAC_NHAN=
ZALO_ZNS_MAU_XEP_THO=
ZALO_ZNS_MAU_BAO_GIA=
ZALO_ZNS_MAU_THANH_TOAN=
ZALO_ZNS_MAU_HOAN_THANH=
ZALO_ZNS_MAU_DANH_GIA=
ZALO_ZNS_MAU_MA_XAC_NHAN=
ZALO_ZNS_MAU_HOA_DON=

# SMS dự phòng khi khách không dùng Zalo (nhà mạng chưa chọn: POST {to, text}, Bearer key)
SMS_URL=
SMS_KEY=

# Ngân hàng: dịch vụ báo tiền về (sepay hoặc casso) gọi webhook POST {SITE_URL}/api/thanh-toan/webhook
NGAN_HANG_NHA_CUNG_CAP=
NGAN_HANG_WEBHOOK_KEY=

# Hoá đơn điện tử (nhà cung cấp chưa chọn)
HOA_DON_URL=
HOA_DON_KEY=

# Khoá cho việc định kỳ POST /api/viec-dinh-ky (service "hen-gio" trong docker-compose dùng). openssl rand -hex 24
VIEC_DINH_KY_KEY=

# VCparts: danh mục hãng, dòng, đời xe
VCPARTS_URL=
VCPARTS_KEY=

# Mật khẩu các tài khoản thử do `npm run nap-du-lieu` tạo (chỉ khi chạy thử)
MAT_KHAU_TAI_KHOAN_THU=
