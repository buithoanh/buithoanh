# Sao chép thành .env rồi điền. KHÔNG commit file .env.
DATABASE_URL=postgres://vc:vc@localhost:5432/vcmobilecare
# Chuỗi ngẫu nhiên dài, tạo bằng: openssl rand -hex 32
PAYLOAD_SECRET=
# Địa chỉ web, không có dấu / ở cuối
SITE_URL=http://localhost:3000
# Chỉ đặt =1 khi đã gắn tên miền thật
ALLOW_INDEX=
# Khoá Claude API cho nút "AI viết bản nháp"
ANTHROPIC_API_KEY=
# Mật khẩu database khi chạy bằng docker compose
POSTGRES_PASSWORD=
